# ── Google Gemini ──────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── ChromaDB ──────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── Embedding Model ───────────────────────────
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ── Memory ────────────────────────────────────
MAX_HISTORY_TURNS=5

# ── Application ───────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
