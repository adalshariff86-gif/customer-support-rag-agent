# ── LLM Provider Selection ──────────────────────
# Options: 'gemini' or 'openrouter'
LLM_PROVIDER=gemini

# ── Google Gemini ──────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenRouter ─────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── ChromaDB ──────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── Embedding Model ───────────────────────────
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ── Memory ────────────────────────────────────
MAX_HISTORY_TURNS=5

# ── Application ───────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Authentication ────────────────────────────
# Leave empty to disable auth (dev only). Set a strong key for production.
API_KEY=

# ── CORS ──────────────────────────────────────
# Comma-separated allowed origins. Use '*' for development.
# Production example: https://your-frontend.example.com
CORS_ORIGINS=*
